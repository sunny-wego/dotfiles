brew "fd"                      # Fast find (required by Telescope)

# Dev Tools
brew "gh"                      # GitHub CLI
brew "oven-sh/bun/bun"        # JS runtime & toolkit
brew "docker"                  # Container engine
brew "docker-compose"          # Multi-container orchestration
brew "yq"                      # YAML/JSON processor
brew "typescript-language-server" # TypeScript LSP

# Modern CLI Tools
brew "tealdeer"                # Fast tldr (man pages)
brew "zoxide"                  # Smarter cd
brew "eza"                     # Modern ls
brew "bat"                     # Modern cat
brew "git-delta"               # Modern git diff

# Terminal UIs
brew "lazydocker"              # Docker TUI
brew "btop"                    # System Monitor
brew "yazi"                    # File Manager
brew "sevenzip"                # Archive support for Yazi

# Productivity & Safety
brew "trash-cli"               # Safe deletion (aliased to del)

