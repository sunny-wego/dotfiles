#!/usr/bin/env bash
# complete-process — thin wrapper so the command documented in SKILL.md exists
# literally. The real implementation is the `complete-process` subcommand of
# monitor-step.sh; this just forwards all args to it.
#
# Usage: complete-process <ISO-watermark> --acked-ids "<id1,id2,...>"
#        (pass --acked-ids "" to ack none and defer all items to the next probe)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec bash "$SCRIPT_DIR/monitor-step.sh" complete-process "$@"
