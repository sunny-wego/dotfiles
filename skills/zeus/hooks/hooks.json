{
  "description": "Zeus workflow hooks: auto-link the active investigation's PR into its Epic (from /zeus:investigate), and nudge /zeus:address-pr after a push LANDS on a PR branch (from /zeus:address-pr). The push hook is `if`-gated to push-ish commands and decides from git/PR state, so it no-ops instantly on unrelated work.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/investigate/hooks/stop-autolink.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/address-pr/hooks/post-push-review.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(bash *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/address-pr/hooks/post-push-review.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
