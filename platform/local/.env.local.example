# Local-parity overrides — copy to local/.env.local (gitignored) and edit.
#
# These layer ON TOP of platform/.env (create that first from .env.example).
# local/up.sh loads both: values here win. Only the auth ISSUER + domain + TLS
# issuer differ from prod; everything inside the platform boundary is identical.

# ── Faithful local DNS: *.apps.127.0.0.1.nip.io all resolve to 127.0.0.1, so
#    Coolify's Traefik does real host-based routing with zero /etc/hosts edits. ─
PLATFORM_DOMAIN=apps.127.0.0.1.nip.io

# ── Real oauth2-proxy against the LOCAL MOCK issuer (not the dev stub) ──────────
# Run with the `local` profile so oauth2-proxy + mock-oidc start. The kiosk's
# identity path is issuer-agnostic, so this is byte-for-byte the prod code path.
AUTH_MODE=google
# The mock's issuer. http + :8080 is fine for an IdP; the app session cookie is
# still Secure because Coolify serves the app over HTTPS (mkcert). This is the
# ONE value that becomes https://accounts.google.com in prod.
OIDC_ISSUER_URL=http://auth.apps.127.0.0.1.nip.io:8080/default
# The mock accepts any client id/secret (no registration), so these are dummies.
# In prod they become the real Google OAuth client credentials.
OAUTH2_PROXY_CLIENT_ID=local-parity
OAUTH2_PROXY_CLIENT_SECRET=local-parity-secret
# Leave blank — up.sh generates a valid local cookie secret if unset.
OAUTH2_PROXY_COOKIE_SECRET=

# ── Coolify running inside Colima — fill from the dashboard after install ──────
# up.sh prints these steps. BASE_URL is your Colima Coolify (up.sh detects the IP).
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT=production
COOLIFY_ENVIRONMENT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_DESTINATION_UUID=
# The Docker network the compose stack + Coolify's tenant apps SHARE (so the
# auth chain + each app's Coolify database are reachable). Must match the base
# compose network name.
COOLIFY_TENANT_NETWORK=platform_tenant
