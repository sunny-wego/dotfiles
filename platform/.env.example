# ─── Internal App Platform — M1 walking skeleton ────────────────────────────
# Copy to `.env` and fill in. `docker compose up` reads this file.
# NOTHING secret is committed: `.env` is gitignored.

# ── Domain & TLS ────────────────────────────────────────────────────────────
# Base domain under which tenant apps and the kiosk are served.
# Local default resolves via *.apps.localhost -> 127.0.0.1 (no DNS needed on
# most systems). On EC2 set this to your internal zone, e.g. apps.internal.
PLATFORM_DOMAIN=apps.localhost

# ── Auth ────────────────────────────────────────────────────────────────────
# dev    -> dev-auth stub (no Google needed); the README's "do the stub first".
# google -> real oauth2-proxy against company Google (see docs/AUTH.md).
AUTH_MODE=dev

# Company domain the platform accepts. Identities outside it are DENIED.
# Enforced by oauth2-proxy (google mode) AND by the kiosk itself (both modes),
# so "a non-company account is denied" is testable even under the dev stub.
COMPANY_EMAIL_DOMAIN=wego.com

# Dev-stub identity (AUTH_MODE=dev only). Set to a non-company address to
# exercise the "non-company account is denied" path locally.
DEV_USER_EMAIL=dev@wego.com

# oauth2-proxy / Google (AUTH_MODE=google only) — see docs/AUTH.md.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# `openssl rand -base64 32`
OAUTH2_PROXY_COOKIE_SECRET=

# ── LLM (LiteLLM -> OpenRouter, ZDR/approved provider) ──────────────────────
# The kiosk's OWN calls (Dockerfile gen + heal) go through LiteLLM, after
# redaction. Set a real key to use the LLM path.
OPENROUTER_API_KEY=
# Master key LiteLLM requires clients to present (the kiosk uses it).
LITELLM_MASTER_KEY=sk-kiosk-local-dev
# Model alias defined in litellm/config.yaml.
KIOSK_LLM_MODEL=dockerfile-gen

# Escape hatch for offline/dev demos: `stub` generates a deterministic
# Dockerfile from detection instead of calling the LLM. `llm` is the product.
# Leave as `llm`; only flip to `stub` when you have no OPENROUTER_API_KEY.
KIOSK_LLM_MODE=llm

# Heal-loop caps (denial-of-wallet guard on the platform's own inference).
KIOSK_HEAL_MAX_ITERATIONS=4
KIOSK_LLM_TOKEN_BUDGET=120000

# ── Slack escalation (optional; logs to audit table if unset) ───────────────
SLACK_WEBHOOK_URL=

# ── Metadata Postgres (kiosk state + append-only audit) ─────────────────────
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=kiosk-local-dev
POSTGRES_DB=kiosk

# ── Build/deploy knobs ──────────────────────────────────────────────────────
# Max unzipped size (zip-bomb guard), in MB.
KIOSK_MAX_UNZIP_MB=512
# Seconds to wait for a freshly-built container to become healthy (verify step).
KIOSK_VERIFY_TIMEOUT_S=40
# Test affordance: poison the first build so the heal loop must recover on a
# later attempt — demonstrates the M1 "heal recovers ≥1 induced failure"
# done-when deterministically. Set to 1 only for that demo. Requires LLM mode.
KIOSK_INDUCE_BUILD_FAILURE=0
