# Copy to .env. Coolify is the engine; these configure the platform services +
# the kiosk. Local (Colima) and remote (EC2) run the same Coolify; only values differ.

# ---- Routing / TLS (Coolify manages the proxy + certs) -----------------------
# Local:  apps.localhost      Remote: apps.internal (Route53 private zone)
BASE_DOMAIN=apps.localhost

# ---- Coolify engine ----------------------------------------------------------
# The kiosk drives Coolify entirely through its API.
COOLIFY_BASE_URL=http://coolify:8000
COOLIFY_API_TOKEN=change-me

# ---- Image registry ----------------------------------------------------------
# Kiosk builds tenant images (heal loop) and pushes here; Coolify deploys FROM here.
REGISTRY_URL=registry.apps.internal
REGISTRY_USER=platform
REGISTRY_PASSWORD=change-me

# ---- Datastores (platform metadata) ------------------------------------------
POSTGRES_PASSWORD=change-me

# ---- Auth (Authelia) ---------------------------------------------------------
AUTHELIA_SESSION_SECRET=change-me-long-random
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-long-random
AUTHELIA_OIDC_HMAC_SECRET=change-me-long-random

# ---- LLM gateway -------------------------------------------------------------
# The ONE upstream key. Held only by the litellm container; never given to tenants.
OPENROUTER_API_KEY=sk-or-...
# Mints/validates per-tenant virtual keys. Held only by litellm + kiosk.
LITELLM_MASTER_KEY=sk-litellm-master-change-me
# The kiosk's own virtual key for Dockerfile generation (mint once via LiteLLM).
CONTROL_PLANE_LLM_KEY=sk-litellm-...

# ---- Notes -------------------------------------------------------------------
# Runtime: standard `runc` (trusted-internal, accident-hardened; no gVisor).
# App secrets live in COOLIFY's encrypted env store — no KEK/age/KMS here.
# Per-tenant network isolation = one Coolify Destination per tenant.
# Cheap per-tenant DB = libSQL/sqld namespaces (or SQLite on a volume).
# EC2: set IMDSv2 hop-limit=1 (near-free insurance); allow egress to openrouter.ai.
