# ─── Internal App Platform — environment ────────────────────────────────────
# Copy to `.env` and run `make up`. `.env` is gitignored — NOTHING here is
# committed once you fill in real secrets.
#
# LEGEND — how to read the tags on each line:
#   [SET]        you must provide this — private, ships with NO default.
#   [SET:prod]   a dev default works locally; you MUST replace it in production.
#   [rotate]     works as-is; change the default before production.
#   [default]    leave as-is; tune only if you know you need to.
#   [optional]   fine to leave blank.
#
# ┌─ Quickest start ──────────────────────────────────────────────────────────┐
# │ LOCAL (laptop/CI): copy this file and `make up`. Zero edits needed — the   │
# │   dev defaults below run a full stack behind the dev-auth stub. The AI     │
# │   Dockerfile path needs OPENROUTER_API_KEY; for a fully keyless local run  │
# │   set KIOSK_LLM_MODE=stub (see the LLM section).                           │
# │ PRODUCTION (EC2 + Google): set the four [SET] / [SET:prod] values, flip    │
# │   AUTH_MODE=google, point PLATFORM_DOMAIN at your zone. See SETUP.md.       │
# └────────────────────────────────────────────────────────────────────────────┘
#
# The ONLY values you must supply yourself (all private, no default):
#   • KIOSK_SECRET_KEY        (production — encrypts secrets at rest)
#   • OAUTH2_PROXY_CLIENT_ID / _SECRET / _COOKIE_SECRET  (google auth mode)
#   • OPENROUTER_API_KEY      (the AI Dockerfile path; skip with LLM stub mode)
# Everything else already has a working value below.

# ── Domain & TLS ────────────────────────────────────────────────────────────
# [default] Base domain for the kiosk and tenant apps.
#   Local default resolves via *.apps.localhost -> 127.0.0.1 (no DNS needed).
#   In production set your internal zone, e.g. apps.internal (+ wildcard DNS/TLS).
PLATFORM_DOMAIN=apps.localhost

# ── Auth ────────────────────────────────────────────────────────────────────
# [default] dev -> dev-auth stub (no Google). google -> oauth2-proxy (docs/AUTH.md).
AUTH_MODE=dev

# [default] Company domain the platform accepts. Identities outside it are DENIED
#   (enforced in BOTH modes), so the denial path is testable under the dev stub.
COMPANY_EMAIL_DOMAIN=wego.com

# [default] Dev-stub identity (AUTH_MODE=dev only). Point at a non-company
#   address (e.g. intruder@gmail.com) to exercise the denial path locally.
DEV_USER_EMAIL=dev@wego.com

# [SET] Google OAuth (AUTH_MODE=google only) — private, no default. See
#   docs/AUTH.md for creating the OAuth client + redirect URI.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# [SET] Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=

# ── LLM (LiteLLM -> OpenRouter, ZDR/approved provider) ──────────────────────
# [SET] The kiosk's OWN calls (Dockerfile gen + heal) go through LiteLLM, after
#   redaction. Private, no default. No key yet? Set KIOSK_LLM_MODE=stub below
#   for a keyless local run (deterministic Dockerfile from detection).
OPENROUTER_API_KEY=
# [rotate] Master key clients present to LiteLLM (the kiosk uses it).
LITELLM_MASTER_KEY=sk-kiosk-local-dev
# [default] Model alias defined in litellm/config.yaml.
KIOSK_LLM_MODEL=dockerfile-gen

# [default] `llm` is the product path (needs OPENROUTER_API_KEY). `stub`
#   templates a Dockerfile from detection with no LLM call — the keyless
#   local/offline path. Flip to `stub` if you have no key.
KIOSK_LLM_MODE=llm

# [default] Heal-loop caps (denial-of-wallet guard on the platform's inference).
KIOSK_HEAL_MAX_ITERATIONS=4
KIOSK_LLM_TOKEN_BUDGET=120000

# ── Slack escalation ────────────────────────────────────────────────────────
# [optional] Unset -> escalations log to the audit table instead of Slack.
SLACK_WEBHOOK_URL=

# ── Secrets + LLM budget (v1) ───────────────────────────────────────────────
# [SET:prod] Encryption key for secrets at rest (app secrets, tenant DB
#   passwords). MUST be stable across restarts. The dev default below WARNS
#   locally and is REFUSED at startup in google mode. Generate a real one:
#   openssl rand -base64 32
KIOSK_SECRET_KEY=kiosk-insecure-dev-key-change-me
# [default] Per-tenant LLM spend cap (USD) for the minted virtual key.
KIOSK_LLM_TENANT_BUDGET=5
# Per-tenant database size + backups are owned by Coolify (see the Coolify block
# below): each tenant DB is a Coolify-managed resource with per-app limits and a
# native scheduled backup — there is no kiosk-side size quota or pg_dump.

# ── Metadata Postgres (kiosk state + append-only audit) ─────────────────────
# [rotate] Change POSTGRES_PASSWORD before production.
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=kiosk-local-dev
POSTGRES_DB=kiosk

# ── Coolify — the deploy engine (README §3) ─────────────────────────────────
# The kiosk drives Coolify through its REST API (deploy-from-image, encrypted
# env store, Scheduled Tasks, CPU/mem limits, TLS/domains, rollback); operators
# get the Coolify dashboard as the admin plane. Install Coolify via
# platform/coolify/install.sh, then fill these in (see platform/coolify/README.md).
#
# [SET] Coolify base URL + an API token scoped to the tenant project (Keys & Tokens).
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
# [SET] Where tenant apps are created — a project + environment + server, and a
#   Destination whose Docker network is COOLIFY_TENANT_NETWORK (must match the
#   network kiosk/postgres/litellm/egress-proxy sit on). Create these once in the
#   dashboard; the kiosk only references the UUIDs.
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT=production
# [SET] Coolify's create-from-image API requires the environment UUID too (not
#   just the name). Copy it from the environment's page in the dashboard.
COOLIFY_ENVIRONMENT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_DESTINATION_UUID=
COOLIFY_TENANT_NETWORK=platform_tenant
# [optional] Per-app resource ceilings Coolify enforces (apply to tenant apps AND
#   their databases). Empty = Coolify default.
COOLIFY_CPU_LIMIT=
COOLIFY_MEMORY_LIMIT=
# ── Per-tenant database backups (native Coolify scheduled backups) ──────────
# [default] Backup cadence for each tenant DB — a cron expression or a Coolify
#   preset (daily/hourly/weekly/monthly), and how many days to keep locally.
COOLIFY_BACKUP_FREQUENCY=daily
COOLIFY_BACKUP_RETENTION_DAYS=7
# [optional] A Coolify S3 storage UUID for off-box backup copies. Configure the
#   S3 storage once in the Coolify dashboard; empty = local backups only.
COOLIFY_BACKUP_S3_STORAGE_UUID=

# ── Build/deploy knobs ──────────────────────────────────────────────────────
# [default] Max unzipped size (zip-bomb guard), in MB.
KIOSK_MAX_UNZIP_MB=512
# [default] Seconds to wait for a freshly-built container to pass the verify probe.
KIOSK_VERIFY_TIMEOUT_S=40
# [default] Docker network for tenant builds. Empty = docker's default network;
#   set `host` where builds must reach an internal mirror/egress proxy.
KIOSK_BUILD_NETWORK=
# [default] Test affordance: poison the first build so the heal loop must recover
#   (demonstrates the M1 "heal recovers >=1 induced failure"). 1 only for that
#   demo; requires LLM mode.
KIOSK_INDUCE_BUILD_FAILURE=0
