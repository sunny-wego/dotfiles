# Copy to .env. Local and remote (internal EC2) use the SAME compose file —
# only these values differ.

# ---- Routing / TLS -----------------------------------------------------------
# Local:  apps.localhost      Remote: apps.internal (Route53 private zone)
BASE_DOMAIN=apps.localhost

# ---- Datastores --------------------------------------------------------------
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=change-me

# ---- Auth (Authelia) ---------------------------------------------------------
AUTHELIA_SESSION_SECRET=change-me-long-random
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-long-random
AUTHELIA_OIDC_HMAC_SECRET=change-me-long-random

# ---- LLM gateway -------------------------------------------------------------
# The ONE upstream key. Held only by the litellm container; never given to tenants.
OPENROUTER_API_KEY=sk-or-...
# Mints/validates virtual keys. Held only by litellm + control-plane.
LITELLM_MASTER_KEY=sk-litellm-master-change-me
# The kiosk's own virtual key for Dockerfile generation (mint once via LiteLLM).
CONTROL_PLANE_LLM_KEY=sk-litellm-...

# ---- Tenant runtime (isolation) ---------------------------------------------
# Trust model: trusted-internal, accident-hardened. Standard runtime everywhere.
# gVisor (`runsc`) is NOT used — kernel escape is a malicious threat, not an
# accidental one. Reserved as a per-app option only if an app later becomes
# internet-facing or handles sensitive data (see docs/isolation-and-scaling.md).
TENANT_RUNTIME=runc

# ---- App secrets: envelope encryption ---------------------------------------
# Creator-provided app secrets are envelope-encrypted at rest in Postgres.
# The data key is wrapped by a KEK whose SOURCE differs by environment:
#   Local: age   Remote: kms
KEK_PROVIDER=age
# age (local dev): path to the private key file — keep OUT of git (.gitignore'd).
AGE_KEY_FILE=./secrets/age.key
# kms (EC2): the KMS key used to wrap per-app data keys. Uncomment on EC2.
# KEK_PROVIDER=kms
# KMS_KEY_ID=arn:aws:kms:REGION:ACCT:key/....

# ---- Egress note -------------------------------------------------------------
# Trusted-internal model: strict egress allowlist is RELAXED (apps may call
# internet SaaS). Keep the near-free part: IMDSv2 hop-limit=1 so containers can't
# reach instance credentials. LiteLLM still reaches openrouter.ai; KMS endpoint
# reachable for the secret KEK on EC2.
