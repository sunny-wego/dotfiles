# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# Theme — TokyoNight Day (matches bat, btop, wezterm)
theme = TokyoNight Day

font-family = JetBrainsMono Nerd Font Mono
# font-family = SF Mono
# font-family = Geist Mono
font-size = 14

# SF Mono ships with wide side-bearings; Ghostty honors the native advance,
# so glyphs look airy vs Terminal.app. Tighten the cell to match.
adjust-cell-width = -5%

# Window padding — matches wezterm (window_padding = 20)
window-padding-x = 10
window-padding-y = 10

# Cursor — matches wezterm (BlinkingBar)
cursor-style = bar
cursor-style-blink = true

# Dim inactive split — matches wezterm (inactive_pane_hsb)
unfocused-split-opacity = 0.9

# --- Splits: tmux-style prefix (Ctrl+b), mirrors wezterm leader ---
# Sequences: press & release the prefix (ctrl+b), then the next key.

# Create splits (wezterm: \ = SplitHorizontal → right, - = SplitVertical → down)
keybind = ctrl+b>backslash=new_split:right
keybind = ctrl+b>minus=new_split:down

# Move between panes — vim style (wezterm: leader h/j/k/l)
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

# Cycle panes — closest Ghostty has to wezterm's numbered PaneSelect (leader q).
# Ghostty 1.3.1 has no jump-to-pane-by-index for splits; only prev/next + directions.
keybind = ctrl+b>n=goto_split:next
keybind = ctrl+b>p=goto_split:previous

# Zoom active pane (wezterm: leader z)
keybind = ctrl+b>z=toggle_split_zoom

# Resize panes (wezterm: leader Shift+h/j/k/l, 5 cells)
keybind = ctrl+b>shift+h=resize_split:left,5
keybind = ctrl+b>shift+j=resize_split:down,5
keybind = ctrl+b>shift+k=resize_split:up,5
keybind = ctrl+b>shift+l=resize_split:right,5

# Equalize panes (wezterm: leader =)
keybind = ctrl+b>equal=equalize_splits
